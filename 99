-- Helper Function: Safe Color Picker Reader
local function GetColor(optionName, defaultColor)
    local opt = Options[optionName]
    if opt then
        if typeof(opt.Value) == "Color3" then
            return opt.Value
        elseif typeof(opt) == "Color3" then
            return opt
        end
    end
    return defaultColor or Color3.fromRGB(255, 255, 255)
end

